<?xml version="1.0"?>
<launch>

  <!-- Deactivates simulation time -->
  <param name="use_sim_time" value="false" />

  <!-- Initializes RPLidar -->
  <include file="$(find rplidar_ros)/launch/rplidar_c1.launch" />

  <!-- Static transform: base_link -> laser -->
  <node pkg="tf" type="static_transform_publisher" name="base_to_laser_broadcaster" args="0 0 0 0 0 0 base_link laser 100" />
  
  <node pkg="my_slam_setup" type="fake_odom_publisher.py" name="fake_odom_publisher" output="screen" />

  <!-- Hector Mapping -->
  <node pkg="hector_mapping" type="hector_mapping" name="hector_mapping" output="screen">
    <param name="base_frame" value="base_link"/>
    <param name="odom_frame" value="odom"/>
    <param name="map_frame" value="map"/>

    <!-- Laser parameters -->
    <param name="scan_topic" value="/scan"/>
    <param name="scan_subscriber_queue_size" value="5"/>

    <!-- No odometry source -->
    <param name="use_odometry" value="false"/>
    <param name="use_pose_update" value="false"/>
    <param name="pub_map_odom_transform" value="true"/>
  </node>

  <!-- Move base: allows robot movement -->
  <node pkg="move_base" type="move_base" name="move_base" output="screen">
    <param name="base_global_planner" value="navfn/NavfnROS"/>
    <param name="base_local_planner" value="base_local_planner/TrajectoryPlannerROS"/>
    <rosparam file="$(find my_slam_setup)/config/costmap_common_params.yaml" command="load" />
    <rosparam file="$(find my_slam_setup)/config/local_costmap_params.yaml" command="load" />
    <rosparam file="$(find my_slam_setup)/config/global_costmap_params.yaml" command="load" />
    <rosparam file="$(find my_slam_setup)/config/local_planner_params.yaml" command="load" /> 
  </node>

  <!-- Geotiff map saving -->
  <arg name="geotiff_map_file_path" default="$(find hector_geotiff)/maps"/>
  <include file="$(find hector_geotiff_launch)/launch/geotiff_mapper.launch">
    <arg name="trajectory_source_frame_name" value="scanmatcher_frame"/>
    <arg name="map_file_path" value="$(arg geotiff_map_file_path)"/>
  </include>

</launch>
