<?xml version="1.0"?>
<launch>
  <arg name="serial_port" default="/dev/ttyUSB0"/>
  <arg name="serial_baudrate" default="460800"/>
  <arg name="laser_x" default="0.0"/>
  <arg name="laser_y" default="0.0"/>
  <arg name="laser_z" default="0.0"/>
  <arg name="laser_yaw" default="0.0"/>
  <arg name="enable_motors" default="false"/>
  <param name="use_sim_time" value="false"/>
  <node pkg="rplidar_ros" type="rplidarNode" name="rplidar" output="screen" required="true">
    <param name="serial_port" value="$(arg serial_port)"/>
    <param name="serial_baudrate" value="$(arg serial_baudrate)"/>
    <param name="frame_id" value="laser"/>
    <param name="inverted" value="false"/>
    <param name="angle_compensate" value="true"/>
    <param name="scan_mode" value="Standard"/>
    <param name="scan_frequency" value="10.0"/>
  </node>
  <!-- Fixed mounting geometry; set measured offsets, including sensor yaw. -->
  <node pkg="tf2_ros" type="static_transform_publisher" name="base_to_laser"
        args="$(arg laser_x) $(arg laser_y) $(arg laser_z) $(arg laser_yaw) 0 0 base_link laser"/>
  <!-- Same reference for this mapping session. No independent wheel/IMU odometry. -->
  <node pkg="tf2_ros" type="static_transform_publisher" name="map_to_odom"
        args="0 0 0 0 0 0 map odom"/>
  <node pkg="hector_mapping" type="hector_mapping" name="hector_mapping" output="screen" required="true">
    <param name="base_frame" value="base_link"/>
    <param name="map_frame" value="map"/>
    <param name="odom_frame" value="odom"/>
    <param name="scan_topic" value="/scan"/>
    <param name="scan_subscriber_queue_size" value="1"/>
    <param name="use_tf_scan_transformation" value="true"/>
    <param name="use_tf_pose_start_estimate" value="false"/>
    <param name="pub_map_odom_transform" value="false"/>
    <param name="pub_map_scanmatch_transform" value="false"/>
    <param name="pub_odometry" value="false"/>
    <param name="map_resolution" value="0.05"/>
    <param name="map_size" value="1024"/>
    <param name="map_pub_period" value="0.5"/>
    <param name="map_update_distance_thresh" value="0.10"/>
    <param name="map_update_angle_thresh" value="0.10"/>
    <param name="laser_min_dist" value="0.10"/>
    <param name="laser_max_dist" value="12.0"/>
  </node>
  <node pkg="my_slam_setup" type="lidar_odometry.py" name="lidar_odometry" output="screen" required="true">
    <param name="data_timeout" value="0.5"/>
  </node>
  <node pkg="move_base" type="move_base" name="move_base" output="screen" required="true">
    <param name="base_global_planner" value="navfn/NavfnROS"/>
    <param name="base_local_planner" value="dwa_local_planner/DWAPlannerROS"/>
    <param name="controller_frequency" value="10.0"/>
    <param name="planner_frequency" value="1.0"/>
    <param name="controller_patience" value="3.0"/>
    <param name="planner_patience" value="5.0"/>
    <param name="recovery_behavior_enabled" value="false"/>
    <param name="clearing_rotation_allowed" value="false"/>
    <rosparam file="$(find my_slam_setup)/config/costmap_common_params.yaml" command="load" ns="global_costmap"/>
    <rosparam file="$(find my_slam_setup)/config/costmap_common_params.yaml" command="load" ns="local_costmap"/>
    <rosparam file="$(find my_slam_setup)/config/global_costmap_params.yaml" command="load"/>
    <rosparam file="$(find my_slam_setup)/config/local_costmap_params.yaml" command="load"/>
    <rosparam file="$(find my_slam_setup)/config/local_planner_params.yaml" command="load"/>
  </node>
  <node if="$(arg enable_motors)" pkg="my_slam_setup" type="motor_controller.py" name="motor_controller"
        output="screen" required="true">
    <rosparam file="$(find my_slam_setup)/config/motors.yaml" command="load"/>
  </node>
</launch>
